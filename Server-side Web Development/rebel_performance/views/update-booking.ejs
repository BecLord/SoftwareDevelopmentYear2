<%- include('partials/head') %>
<h1><%= title %></h1>

<form action="/booking/update_complete" method="POST">
  <input type="hidden" name="_id" value="<%= booking._id %>">

  <div>
    <label for="traineeName">Trainee Name:</label>
    <input type="text" name="traineeName" value="<%= booking.traineeName %>" required>
  </div>

  <div>
    <label for="membershipID">Membership ID:</label>
    <input type="text" name="membershipID" value="<%= booking.membershipID %>" required>
  </div>

  <div>
    <label for="className">Class Name:</label>
    <input type="text" name="className" value="<%= booking.className %>" required>
  </div>

  <div>
    <label for="trainingDate">Training Date:</label>
    <input type="datetime-local" name="trainingDate" value="<%= booking.trainingDate.toISOString().slice(0, 16) %>" required>
  </div>

  <button type="submit">Update Booking</button>
</form>


<%- include('partials/foot') %>
